{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connectome.app/schemas/diagram-type.schema.json",
  "title": "Connectome diagram type",
  "description": "Defines a kind of diagram: allowed types, symbols, colour rules, labels, layout, legend and generation. See 02-model/diagrams-and-catalogues.md §3.",
  "type": "object",
  "required": [
    "key",
    "name",
    "objectTypes"
  ],
  "additionalProperties": false,
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "canvas",
        "matrix",
        "document",
        "sequence"
      ],
      "default": "canvas",
      "description": "The view kind. See 02-model/views-and-design-artifacts.md §2."
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "description": "build (slice DOC-1): what this type's diagrams are about. A diagram's subject is set when it is made from an element (a child diagram, New from an element) and kept in its definition's subject. A document takes the element types it accepts from document.subject. See 02-model/views-and-design-artifacts.md §12.",
      "properties": {
        "type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Element types (and their subtypes) a diagram of this type may be about; absent = any"
        },
        "category": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "linkKind": {
          "type": "string",
          "description": "build (slice DOC-R2): a link kind of the package (linkKinds); making a diagram of this type about an element adds a link of this kind to the element, in the same change"
        }
      }
    },
    "decomposes": {
      "type": "object",
      "required": [
        "relationship"
      ],
      "additionalProperties": false,
      "description": "build (slice DOC-1b): diagrams of this type decompose their subject through a relationship type: what is drawn on one becomes a part of its subject, parts missing from it are offered, and a breadcrumb leads back up. See 02-model/views-and-design-artifacts.md §12.",
      "properties": {
        "relationship": {
          "type": "string",
          "description": "The relationship type from the subject to each part, e.g. composedOf"
        },
        "childTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Element types (and their subtypes) that become parts when drawn; absent = any the rules allow"
        }
      }
    },
    "lineAbstraction": {
      "enum": [
        "conceptual",
        "logical",
        "physical",
        "implementation"
      ],
      "description": "build (slice DOC-2): the semantic.abstraction a relationship drawn on a diagram of this type gets, when it differs from its type's default"
    },
    "matrix": {
      "type": "object",
      "required": [
        "rows",
        "columns",
        "relationships"
      ],
      "additionalProperties": false,
      "description": "A matrix type's default definition (views-and-design-artifacts.md §4); a diagram's definition overrides it key by key.",
      "properties": {
        "rows": {
          "$ref": "#/$defs/scope"
        },
        "columns": {
          "$ref": "#/$defs/scope"
        },
        "relationships": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kinds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dir": {
              "enum": [
                "rowToColumn",
                "columnToRow",
                "either"
              ]
            }
          }
        },
        "create": {
          "type": "string"
        },
        "groupRows": {
          "type": "boolean"
        },
        "hideEmpty": {
          "type": "boolean"
        }
      }
    },
    "document": {
      "type": "object",
      "required": [
        "sections"
      ],
      "additionalProperties": false,
      "description": "A document template (views-and-design-artifacts.md §7.1, §8): the subject it is about and its sections, regions and patterns, optionally extending another template.",
      "properties": {
        "subject": {
          "$ref": "#/$defs/scopeFilter"
        },
        "extends": {
          "type": "string",
          "description": "Another document diagram type whose sections come first"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/section"
              },
              {
                "$ref": "#/$defs/region"
              },
              {
                "$ref": "#/$defs/patternUse"
              }
            ]
          }
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sectionOverride"
          }
        }
      }
    },
    "objectTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "relationshipTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nesting": {
      "enum": [
        "nested",
        "lines"
      ],
      "default": "nested",
      "description": "How nesting relationships are shown"
    },
    "showExistingRelationships": {
      "type": "boolean",
      "default": true,
      "description": "Offer relationships between shown objects as faint lines"
    },
    "symbols": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      },
      "description": "Object type key → symbol override"
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Property types diagrams of this type carry (build: slice A-1b)"
    },
    "renditions": {
      "type": "object",
      "additionalProperties": false,
      "description": "Which rendition occurrences start in, and the zoom levels below which every occurrence draws smaller. See 02-model/notation-and-metamodel-admin.md §4.",
      "properties": {
        "default": {
          "type": "string",
          "description": "A rendition key: box, card, glyph, chip or container"
        },
        "semanticZoom": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "below",
              "rendition"
            ],
            "additionalProperties": false,
            "properties": {
              "below": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "rendition": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "colourRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "when",
          "apply"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "when": {
            "type": "string",
            "description": "Query filter, e.g. 'type:application'"
          },
          "apply": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "colourBy"
                ],
                "additionalProperties": false,
                "properties": {
                  "colourBy": {
                    "type": "string",
                    "description": "A list property: uses its value colours"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "gradient"
                ],
                "additionalProperties": false,
                "properties": {
                  "gradient": {
                    "type": "object",
                    "required": [
                      "property",
                      "min",
                      "max",
                      "from",
                      "to"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "property": {
                        "type": "string"
                      },
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      },
                      "from": {
                        "type": "string"
                      },
                      "to": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "badge"
                ],
                "additionalProperties": false,
                "properties": {
                  "badge": {
                    "type": "object",
                    "required": [
                      "icon",
                      "tooltip"
                    ],
                    "properties": {
                      "icon": {
                        "type": "string"
                      },
                      "tooltip": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "fade"
                ],
                "additionalProperties": false,
                "properties": {
                  "fade": {
                    "const": true
                  }
                }
              }
            ]
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Object type key → label template"
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "enum": [
            "nested",
            "layered",
            "grid",
            "radial",
            "none"
          ]
        },
        "direction": {
          "enum": [
            "down",
            "right"
          ]
        },
        "spacing": {
          "type": "integer"
        }
      }
    },
    "legend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show": {
          "type": "boolean"
        },
        "position": {
          "enum": [
            "topRight",
            "bottomRight",
            "bottomLeft"
          ]
        }
      }
    },
    "inactiveObjects": {
      "enum": [
        "show",
        "fade",
        "hide"
      ],
      "default": "fade",
      "description": "Objects not active on the 'as of' date"
    },
    "generate": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "forEach",
          "include",
          "name",
          "folder"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "forEach": {
            "type": "string",
            "description": "Query: one diagram per matching object"
          },
          "include": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "depth": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                }
              }
            }
          },
          "layout": {
            "enum": [
              "nested",
              "layered",
              "grid",
              "radial"
            ]
          },
          "name": {
            "type": "string"
          },
          "folder": {
            "type": "string"
          },
          "orphans": {
            "enum": [
              "archive",
              "delete",
              "keep"
            ],
            "default": "archive"
          },
          "trigger": {
            "enum": [
              "manual",
              "onChange",
              "nightly"
            ],
            "default": "manual"
          }
        }
      }
    }
  },
  "$defs": {
    "scopeFilter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "folder": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "from"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/scopeFilter"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dir"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "kind": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "dir": {
                "enum": [
                  "out",
                  "in",
                  "either"
                ]
              },
              "to": {
                "$ref": "#/$defs/scopeFilter"
              }
            }
          }
        },
        "order": {
          "enum": [
            "name",
            "rank"
          ]
        }
      }
    },
    "relationshipFilter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sectionAllow": {
      "type": "object",
      "additionalProperties": false,
      "description": "Freedoms of a configurable section (§8.2)",
      "properties": {
        "addProperties": {
          "type": "boolean"
        },
        "columns": {
          "type": "boolean"
        },
        "hide": {
          "type": "boolean"
        }
      }
    },
    "section": {
      "description": "One section of a document template: one component with its configuration (§8.1)",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "key",
            "title",
            "component"
          ],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]*$"
            },
            "title": {
              "type": "string"
            },
            "guidance": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "lock": {
              "enum": [
                "fixed",
                "configurable",
                "free"
              ],
              "description": "What authors may change (views-and-design-artifacts.md §8.2); default configurable"
            },
            "allow": {
              "$ref": "#/$defs/sectionAllow"
            },
            "after": {
              "type": "string",
              "description": "In a template that extends another: insert after this section of the base"
            },
            "component": {
              "const": "heading"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "key",
            "title",
            "component"
          ],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]*$"
            },
            "title": {
              "type": "string"
            },
            "guidance": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "lock": {
              "enum": [
                "fixed",
                "configurable",
                "free"
              ],
              "description": "What authors may change (views-and-design-artifacts.md §8.2); default configurable"
            },
            "allow": {
              "$ref": "#/$defs/sectionAllow"
            },
            "after": {
              "type": "string",
              "description": "In a template that extends another: insert after this section of the base"
            },
            "component": {
              "const": "prose"
            },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mentions": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "create": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "key",
            "title",
            "component",
            "config"
          ],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]*$"
            },
            "title": {
              "type": "string"
            },
            "guidance": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "lock": {
              "enum": [
                "fixed",
                "configurable",
                "free"
              ],
              "description": "What authors may change (views-and-design-artifacts.md §8.2); default configurable"
            },
            "allow": {
              "$ref": "#/$defs/sectionAllow"
            },
            "after": {
              "type": "string",
              "description": "In a template that extends another: insert after this section of the base"
            },
            "component": {
              "const": "facts"
            },
            "config": {
              "type": "object",
              "required": [
                "properties"
              ],
              "additionalProperties": false,
              "properties": {
                "properties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "of": {
                  "enum": [
                    "row",
                    "relationship"
                  ],
                  "description": "Inside a repeater: the row's counterpart (default) or its relationship"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "key",
            "title",
            "component",
            "config"
          ],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]*$"
            },
            "title": {
              "type": "string"
            },
            "guidance": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "lock": {
              "enum": [
                "fixed",
                "configurable",
                "free"
              ],
              "description": "What authors may change (views-and-design-artifacts.md §8.2); default configurable"
            },
            "allow": {
              "$ref": "#/$defs/sectionAllow"
            },
            "after": {
              "type": "string",
              "description": "In a template that extends another: insert after this section of the base"
            },
            "component": {
              "const": "diagramLink"
            },
            "config": {
              "type": "object",
              "required": [
                "diagramType"
              ],
              "additionalProperties": false,
              "properties": {
                "diagramType": {
                  "type": "string"
                },
                "placeSubject": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "key",
            "title",
            "component",
            "config"
          ],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]*$"
            },
            "title": {
              "type": "string"
            },
            "guidance": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "lock": {
              "enum": [
                "fixed",
                "configurable",
                "free"
              ],
              "description": "What authors may change (views-and-design-artifacts.md §8.2); default configurable"
            },
            "allow": {
              "$ref": "#/$defs/sectionAllow"
            },
            "after": {
              "type": "string",
              "description": "In a template that extends another: insert after this section of the base"
            },
            "component": {
              "const": "relationTable"
            },
            "config": {
              "type": "object",
              "required": [
                "source",
                "columns"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "object",
                  "required": [
                    "relationships"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "section": {
                      "type": "string"
                    },
                    "relationships": {
                      "$ref": "#/$defs/relationshipFilter"
                    }
                  }
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "required": [
                          "key",
                          "label",
                          "properties"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "properties": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    ]
                  }
                },
                "required": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "add": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "types": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "kinds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "missing": {
                  "type": "boolean"
                },
                "perRow": {
                  "type": "object",
                  "required": [
                    "sequence"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "sequence": {
                      "type": "string"
                    }
                  }
                },
                "expand": {
                  "type": "object",
                  "required": [
                    "property"
                  ],
                  "additionalProperties": false,
                  "description": "build (slice DOC-2): under each row, what its connection stands for: the elements in a reference property, and the more concrete flows its ends' scopes imply (02-model/views-and-design-artifacts.md §12)",
                  "properties": {
                    "property": {
                      "type": "string",
                      "description": "An objectRef property with many on the rows' relationship types"
                    },
                    "exclude": {
                      "type": "string",
                      "description": "An objectRef property with many holding the implied elements a connection does not stand for"
                    },
                    "add": {
                      "type": "object",
                      "required": [
                        "types"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "types": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "sequence": {
                      "type": "string",
                      "description": "A sequence diagram type: one diagram about each element, created on demand"
                    },
                    "required": {
                      "type": "boolean",
                      "description": "A row is to describe until it stands for at least one element or implied flow"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "key",
            "title",
            "component",
            "config"
          ],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]*$"
            },
            "title": {
              "type": "string"
            },
            "guidance": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "lock": {
              "enum": [
                "fixed",
                "configurable",
                "free"
              ],
              "description": "What authors may change (views-and-design-artifacts.md §8.2); default configurable"
            },
            "allow": {
              "$ref": "#/$defs/sectionAllow"
            },
            "after": {
              "type": "string",
              "description": "In a template that extends another: insert after this section of the base"
            },
            "component": {
              "const": "repeater"
            },
            "config": {
              "type": "object",
              "required": [
                "source",
                "sections"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "object",
                  "required": [
                    "section"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "section": {
                      "type": "string",
