              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "lock": {
              "enum": [
                "fixed",
                "configurable",
                "free"
              ],
              "description": "What authors may change (views-and-design-artifacts.md §8.2); default configurable"
            },
            "allow": {
              "$ref": "#/$defs/sectionAllow"
            },
            "after": {
              "type": "string",
              "description": "In a template that extends another: insert after this section of the base"
            },
            "component": {
              "const": "register"
