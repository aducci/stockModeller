{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connectome.app/schemas/metamodel.schema.json",
  "title": "Connectome metamodel package",
  "description": "Object types, relationship types, property types, value lists and rules. Diagram types use diagram-type.schema.json. See 02-model/metamodel.md.",
  "type": "object",
  "required": [
    "name",
    "version",
    "objectTypes",
    "relationshipTypes"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "prefix": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*$",
      "description": "Key prefix when installed as a package, e.g. 'archimate'"
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "valueLists": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/valueList"
      }
    },
    "propertyTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/propertyType"
      }
    },
    "objectTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objectType"
      }
    },
    "relationshipTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationshipType"
      }
    },
    "relationshipRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationshipRule"
      }
    },
    "validationRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validationRule"
      }
    },
    "derivationRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derivationRule"
      }
    },
    "exchangeMappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exchangeMapping"
      },
      "description": "How standard file formats map onto this package's types (used by import/export adapters)"
    },
    "documentPatterns": {
      "type": "array",
      "description": "Reusable groups of document sections (views-and-design-artifacts.md §8.4). A string \"$template.<param>\" in a section is replaced by the parameter; sections are checked against diagram-type.schema.json once a template resolves them",
      "items": {
        "type": "object",
        "required": [
          "key",
          "name",
          "sections"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string"
                },
                "default": {}
              }
            }
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "anyOf": [
                {
                  "required": [
                    "key",
                    "title",
                    "component"
                  ]
                },
                {
                  "required": [
                    "region",
                    "title",
                    "palette"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)?$"
    },
    "typeRef": {
      "type": "string",
      "pattern": "^(\\*|[a-z][a-zA-Z0-9]*)$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "layer": {
      "type": "object",
      "required": [
        "key",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "color": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "valueList": {
      "type": "object",
      "required": [
        "key",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "color": {
                "$ref": "#/$defs/color"
              },
              "order": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "propertyType": {
      "type": "object",
      "required": [
        "key",
        "name",
        "group",
        "dataType"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key",
          "description": "'<group>.<name>', e.g. 'lifecycle.status'"
        },
        "name": {
          "type": "string"
        },
        "group": {
          "$ref": "#/$defs/key"
        },
        "dataType": {
          "enum": [
            "text",
            "richText",
            "number",
            "money",
            "date",
            "boolean",
            "list",
            "multiList",
            "objectRef",
            "person",
            "url",
            "calculated"
          ]
        },
        "unit": {
          "type": "string"
        },
        "valueList": {
          "$ref": "#/$defs/key"
        },
        "objectTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typeRef"
          }
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "help": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "editor": {
          "enum": [
            "auto",
            "dropdown",
            "segmented",
            "radio",
            "rating",
            "switch",
            "checkbox",
            "checkboxes",
            "chips"
          ],
          "description": "build: how the properties panel edits the value; auto (default) chooses from the data type and the value list"
        },
        "master": {
          "type": "string"
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "pattern": {
              "type": "string"
            },
            "maxLength": {
              "type": "integer"
            },
            "decimals": {
              "type": "integer"
            }
          }
        },
        "formula": {
          "type": "object",
          "required": [
            "expression",
            "resultType"
          ],
          "additionalProperties": false,
          "properties": {
            "expression": {
              "type": "string"
            },
            "resultType": {
              "enum": [
                "text",
                "number",
                "money",
                "date",
                "boolean",
                "list"
              ]
            }
          }
        }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "enum": [
            "rect",
            "roundRect",
            "ellipse",
            "hexagon",
            "cylinder",
            "person",
            "icon"
          ]
        },
        "fill": {
          "$ref": "#/$defs/color"
        },
        "stroke": {
          "$ref": "#/$defs/color"
        },
        "icon": {
          "type": "string"
        },
        "rendition": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {
          "enum": [
            "solid",
            "dashed",
            "dotted"
          ]
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "startArrow": {
          "enum": [
            "none",
            "arrow",
            "diamond",
            "circle"
          ]
        },
        "endArrow": {
          "enum": [
            "none",
            "arrow",
            "diamond",
            "circle"
          ]
        }
      }
    },
    "objectType": {
      "type": "object",
      "required": [
        "key",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "type": "string"
        },
        "plural": {
          "type": "string"
        },
        "extends": {
          "$ref": "#/$defs/key"
        },
        "abstract": {
          "type": "boolean"
        },
        "layer": {
          "$ref": "#/$defs/key"
        },
        "description": {
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "symbol": {
          "$ref": "#/$defs/symbol"
        },
        "uniqueName": {
          "enum": [
            "repository",
            "folder",
            "container",
            "none"
          ]
        },
        "uniqueAcross": {
          "enum": [
            "type",
            "family"
          ],
          "description": "family: a name also clashes with objects of parent, child and sibling types"
        },
        "uniquePerLevel": {
          "type": "boolean",
          "description": "Default true: names only clash at the same semantic level"
        },
        "onClash": {
          "enum": [
            "block",
            "warn"
          ],
          "description": "Default block; warn saves the object and adds a finding"
        },
        "keyPattern": {
          "type": "string"
        },
        "defaultFolder": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/semanticCategory"
        },
        "level": {
          "$ref": "#/$defs/semanticLevel",
          "description": "Default semantic.level of objects of this type"
        },
        "levelFixed": {
          "type": "boolean",
          "description": "Objects of this type always have the type's level"
        },
        "propertySets": {
          "type": "array",
          "description": "build: named selections of the type's properties for the properties panel and review pages; inherited, a subtype's set replaces one with the same key",
          "items": {
            "type": "object",
            "required": [
              "key",
              "name",
              "properties"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "$ref": "#/$defs/key"
              },
              "name": {
                "type": "string"
              },
              "properties": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/key"
                }
              }
            }
          }
        }
      }
    },
    "relationshipType": {
      "type": "object",
      "required": [
        "key",
        "name",
        "verb",
        "inverseVerb"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "type": "string"
        },
        "verb": {
          "type": "string"
        },
        "inverseVerb": {
          "type": "string"
        },
        "semantic": {
          "$ref": "#/$defs/semanticKind",
          "description": "Default: association"
        },
        "semanticDirection": {
          "enum": [
            "forward",
            "reverse"
          ],
          "description": "reverse: the type's source plays the kind's target role (e.g. 'realised by')"
        },
        "cascadeDelete": {
          "type": "boolean",
          "description": "composition only: deleting the whole deletes its parts"
        },
        "distinct": {
          "enum": [
            "pair",
            "pairAndPayload",
            "none"
          ],
          "description": "What counts as a duplicate relationship of this type: same ends, or same ends and payload. Default by kind: pairAndPayload for flow, trigger and interaction, pair otherwise"
        },
        "payload": {
          "enum": [
            "none",
            "optional",
            "expected"
          ],
          "description": "Whether relationships carry objects; default optional for flow and trigger kinds, none otherwise"
        },
        "nesting": {
          "type": "boolean",
          "description": "Forms hierarchies; can be shown by placing a symbol inside another"
        },
        "singleParent": {
          "type": "boolean"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "line": {
          "$ref": "#/$defs/line"
        }
      }
    },
    "relationshipRule": {
      "type": "object",
      "required": [
        "relationshipType",
        "sourceType",
        "targetType"
      ],
      "additionalProperties": false,
      "properties": {
        "relationshipType": {
          "$ref": "#/$defs/key"
        },
        "sourceType": {
          "$ref": "#/$defs/typeRef"
        },
        "targetType": {
          "$ref": "#/$defs/typeRef"
        },
        "cardinality": {
          "enum": [
            "0..1",
            "0..*",
            "1..1",
            "1..*"
          ]
        },
        "enforcement": {
          "enum": [
            "block",
            "warn"
          ],
          "default": "block"
        }
      }
    },
    "validationRule": {
      "type": "object",
      "required": [
        "key",
        "when",
        "check",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "when": {
          "type": "string"
        },
        "check": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "default": "warning"
        }
      }
    },
    "derivationRule": {
      "type": "object",
      "required": [
        "key",
        "derive",
        "from"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "derive": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "store": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "exchangeMapping": {
      "type": "object",
      "required": [
        "format"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "description": "Adapter id, e.g. 'archimateExchange', 'bpmn', 'mermaid'"
        },
        "objectTypes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Format element name → object type key"
        },
        "relationshipTypes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Format relationship name → relationship type key"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Format property name → property type key"
        }
      }
    },
    "semanticKind": {
      "enum": [
        "containment",
        "composition",
        "aggregation",
        "association",
        "realisation",
        "representation",
        "serving",
        "access",
        "flow",
        "trigger",
        "assignment",
        "influence",
        "specialisation",
        "interaction"
      ],
      "description": "What the engine understands a relationship type to mean (02-model/semantics.md §2)"
    },
    "semanticCategory": {
      "enum": [
        "actor",
        "capability",
        "behaviour",
        "service",
        "interface",
        "component",
        "information",
        "technology",
        "location",
        "motivation",
        "other"
      ],
      "description": "What kind of thing an object type is (02-model/semantics.md §4.1)"
    },
    "semanticLevel": {
      "enum": [
        "conceptual",
        "logical",
        "physical",
        "implementation"
      ],
      "description": "How concrete an object is (02-model/semantics.md §4.2)"
    }
  }
}
