{
  "key": "hld",
  "name": "High-level design",
  "description": "A design artifact about one application: summary, key facts, its context diagram and a described row for every connection drawn on it, with the information flows each stands for, and its RAID register.",
  "kind": "document",
  "subject": {
    "linkKind": "document"
  },
  "objectTypes": [
    "applicationBase",
    "service"
  ],
  "document": {
    "subject": {
      "type": [
        "applicationBase",
        "service"
      ]
    },
    "sections": [
      {
        "key": "summary",
        "title": "Summary",
        "component": "prose",
        "required": true,
        "lock": "fixed",
        "guidance": "What changes and why, in a few lines. Type @ to mention an element of the model, @+ to create one.",
        "config": {
          "mentions": {
            "create": true
          }
        }
      },
      {
        "key": "facts",
        "title": "Key facts",
        "component": "facts",
        "allow": {
          "addProperties": true
        },
        "config": {
          "properties": [
            "lifecycle.status",
            "ownership.businessOwner",
            "ownership.technicalOwner",
            "assessment.criticality",
            "cost.runCost"
          ]
        }
      },
      {
        "use": "contextAndIntegrations",
        "with": {
          "perRow": {
            "sequence": "sequence"
          },
          "title": "Information flows",
          "expand": {
            "property": "integration.informationFlows",
            "exclude": "integration.excludedFlows",
            "add": {
              "label": "Add flow",
              "types": [
                "informationFlow",
                "applicationFunction"
              ]
            },
            "sequence": "sequence"
          }
        }
      },
      {
        "key": "raid",
        "title": "RAID",
        "component": "register",
        "guidance": "Risks, assumptions, issues and dependencies: those this design mentions, those about its subject, and those about what its context shows.",
        "config": {
          "types": [
            "raidItem"
          ],
          "from": [
            "mentions",
            "subject",
            "members"
          ],
          "via": {
            "types": [
              "concerns"
            ]
          },
          "groupBy": "type",
          "columns": [
            "raid.status",
            "raid.owner",
            "raid.dueDate",
            "raid.impact",
            "raid.likelihood"
          ],
          "add": {
            "label": "Add RAID item",
            "types": [
              "risk",
              "assumption",
              "issue",
              "dependency"
            ],
            "relationship": "concerns"
          },
          "checks": [
            {
              "rule": "notEmpty",
              "column": "raid.owner",
              "where": {
                "raid.status": "open"
              }
            }
          ]
        }
      },
      {
        "key": "risks",
        "title": "Notes",
        "component": "prose",
        "allow": {
          "hide": true
        },
        "guidance": "Anything else about what could go wrong or is still to decide. Select a sentence and choose Make RAID item to track it in the register."
      },
      {
        "region": "additional",
        "title": "Additional sections",
        "guidance": "Add what this design needs beyond the template.",
        "palette": [
          "heading",
          "prose",
          "facts",
          "diagramLink",
          "relationTable"
        ],
        "max": 6
      }
    ]
  }
}
