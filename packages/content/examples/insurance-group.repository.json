      "diagramType": "integrationSpec",
      "folderId": "F09",
      "definition": {
        "subject": "O-INT-2",
        "purpose": {
          "paragraphs": [
            [
              {
                "mention": "O-INT-2"
              },
              " takes payment instructions for settled claims and confirms them. ",
              {
                "mention": "O-APP-3"
              },
              " provides it; ",
              {
                "mention": "O-APP-1"
              },
              " is its only caller today."
            ]
          ]
        },
        "context": {
          "diagramId": "D-06"
        },
        "details": {
          "rows": {
            "R-16": {
              "sequence": {
                "diagramId": "D-05"
              },
              "errors": {
                "paragraphs": [
                  [
                    "A timeout is retried twice with the same idempotency key; after that the payment is queued for the claims team."
                  ]
                ]
              }
            }
          }
        }
      },
