    {
      "id": "D-04",
      "name": "Claims Manager high-level design",
      "diagramType": "hld",
      "folderId": "F09",
      "definition": {
        "subject": "O-APP-1",
        "summary": {
          "paragraphs": [
            [
              "Claims Manager registers and assesses claims for the ",
              {
                "mention": "O-ORG-1"
              },
              ". It pays settled claims through ",
              {
                "mention": "O-INT-2"
              },
              ", which ",
              {
                "mention": "O-APP-3"
              },
              " provides, and takes new claims from ",
              {
                "mention": "O-APP-2"
              },
              " until that is retired."
            ]
          ]
        },
        "context": {
          "diagramId": "D-03"
        },
        "integrations": {
          "sequences": {
            "R-16": "D-05"
          }
        },
        "risks": {
          "paragraphs": [
            [
              "The nightly SFTP feed from ",
              {
                "mention": "O-APP-2"
              },
              " has no retry; a missed file delays new claims by a day."
            ],
            ["Open: whether payment confirmations should move to events once Payments Hub supports them."]
          ]
        }
      },
      "objectOccurrences": [],
      "relationshipOccurrences": [],
      "annotations": []
    },
