    {
      "key": "cost.runCost",
      "name": "Run cost",
      "group": "cost",
      "dataType": "money",
      "unit": "per year"
    },
    {
      "key": "cost.totalCost",
      "name": "Total cost",
      "group": "cost",
      "dataType": "calculated",
      "formula": {
        "expression": "coalesce(cost.runCost, 0) + sum(-contains->.cost.totalCost)",
        "resultType": "money"
      }
    },
    {
      "key": "cost.applicationCount",
      "name": "Applications",
      "group": "cost",
      "dataType": "calculated",
      "formula": {
        "expression": "count(<-realizes- type:application OR type:saasApplication)",
        "resultType": "number"
      }
    },
    {
      "key": "documentation.link",
      "name": "Documentation",
      "group": "documentation",
      "dataType": "url",
      "many": true,
      "help": "Where it is documented: web pages, and the documents and diagrams about it in this repository"
    },
    {
      "key": "technical.users",
      "name": "Number of users",
      "group": "technical",
